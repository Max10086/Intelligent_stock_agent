// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model EmailVerificationChallenge {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model User {
  id          String   @id
  email       String   @unique
  displayName String?
  avatarUrl   String?
  isPaid      Boolean  @default(false)
  paidUntil   DateTime?
  paypalSubscriptionId String? @unique
  subscriptionStatus String?
  isAdmin     Boolean  @default(false)
  firstAnalysisAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analysisJobs          AnalysisJob[]
  comparisonSessions    ComparisonSession[]
  companyAnalysisUsages CompanyAnalysisUsage[]
  userEvents            UserEvent[]
  returnTrackingAnchors ReturnTrackingAnchor[]
  feedback              UserFeedback[]
  gainerPreference      UserGainerPreference?

  @@index([createdAt])
  @@index([paidAt])
  @@index([firstAnalysisAt])
}

model UserFeedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  message   String
  rating    Int?
  context   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([category, createdAt])
  @@index([createdAt])
}

model CompanyAnalysisUsage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageDate String
  reportId  String
  companyId String
  ticker    String
  createdAt DateTime @default(now())

  @@unique([userId, reportId, companyId, usageDate])
  @@index([userId, usageDate])
}

model UserEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  path      String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model BatchJob {
  id          String         @id @default(uuid())
  userId      String?
  tickers     String         // Comma-separated list of tickers/queries
  status      JobStatus      @default(PENDING)
  language    String         @default("en")
  source      String?        // manual | gainer_manual | gainer_auto
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?
  error       String?
  
  // Relationship to individual analysis jobs
  jobs        AnalysisJob[]
  
  @@index([status])
  @@index([createdAt])
}

model ComparisonSession {
  id        String          @id @default(uuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  language  String          @default("cn")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  runs      ComparisonRun[]

  @@index([updatedAt])
  @@index([userId, updatedAt])
}

enum CompareRunStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model ComparisonRun {
  id              String            @id @default(uuid())
  sessionId       String
  session         ComparisonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentRunId     String?
  parentRun       ComparisonRun?    @relation("CompareRunChain", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns       ComparisonRun[]   @relation("CompareRunChain")
  createdAt       DateTime          @default(now())
  status          CompareRunStatus  @default(COMPLETED)
  progress        Int               @default(100)
  currentStep     String?
  error           String?
  items           String
  marketHotTopics String
  result          String
  digests         String?
  changeSummary   String?

  @@index([sessionId, createdAt])
  @@index([parentRunId])
  @@index([status])
}

model ReturnTrackingAnchor {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType  String
  sourceId    String
  companyKey  String
  ticker      String
  exchange    String
  companyName String?
  anchorPrice String
  anchorDate  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots ReturnTrackingSnapshot[]

  @@unique([sourceType, sourceId, companyKey])
  @@index([sourceType, sourceId])
  @@index([userId])
}

model ReturnTrackingSnapshot {
  id           String               @id @default(uuid())
  anchorId     String
  anchor       ReturnTrackingAnchor @relation(fields: [anchorId], references: [id], onDelete: Cascade)
  observedDate String
  price        String
  returnPct    Float
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([anchorId, observedDate])
  @@index([anchorId, observedDate])
}

model AnalysisJob {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchJobId  String?
  batchJob    BatchJob? @relation(fields: [batchJobId], references: [id], onDelete: Cascade)
  ticker      String
  query       String    // Original user query (e.g., "AAPL" or "Apple")
  status      JobStatus @default(PENDING)
  language    String    @default("en") // 'en' or 'cn'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  
  // Progress tracking
  progress        Int       @default(0)   // 0 to 100
  currentStep     String?   // e.g., "Analyzing Competitors", "Generating Questions", "Answering Question 3/10"
  logs            String?   // Optional: JSON string array of log history
  
  // Analysis result data (stored as JSON)
  result      String?   // JSON string of AnalysisState
  listSummary String?   // Precomputed slim list payload (no Q&A); for fast GET /api/history

  @@index([status])
  @@index([createdAt])
  @@index([batchJobId])
  @@index([userId, completedAt])
  @@index([userId, status, completedAt])
}

enum GainerMarket {
  US
  CN
  HK
}

enum GainerPeriod {
  DAILY
  WEEKLY
  THREE_DAY
}

model MarketGainerSnapshot {
  id               String         @id @default(uuid())
  market           GainerMarket
  period           GainerPeriod
  tradingDateEnd   String
  tradingDateStart String?
  modelProvider    String
  modelName        String
  status           String         @default("PENDING")
  error            String?
  rawResponse      String?
  fetchedAt        DateTime       @default(now())
  entries          MarketGainerEntry[]

  @@unique([market, period, tradingDateEnd])
  @@index([market, period, fetchedAt])
}

model MarketGainerEntry {
  id         String               @id @default(uuid())
  snapshotId String
  snapshot   MarketGainerSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  rank       Int
  name       String
  ticker     String
  exchange   String?
  changePct  Float
  blurb      String
  validated  Boolean              @default(false)
  createdAt  DateTime             @default(now())

  @@index([ticker, createdAt])
  @@index([snapshotId, rank])
}

model MarketGainerAppearance {
  id                     String       @id @default(uuid())
  market                 GainerMarket
  ticker                 String
  name                   String
  appearanceScore        Int          @default(0)
  dailyAppearances14d    Int          @default(0)
  weeklyAppearances14d   Int          @default(0)
  lastSeenAt             DateTime
  firstSeenAt            DateTime
  autoAnalyzeEligible    Boolean      @default(false)
  autoAnalyzeTriggeredAt DateTime?
  updatedAt              DateTime     @updatedAt

  @@unique([market, ticker])
  @@index([appearanceScore])
  @@index([autoAnalyzeEligible])
}

model UserGainerPreference {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoAnalyzeEnabled   Boolean  @default(false)
  autoAnalyzeMarkets   String   @default("US,CN")
  minAppearanceScore   Int      @default(2)
  maxAutoTickersPerRun Int      @default(5)
  language             String   @default("cn")
  updatedAt            DateTime @updatedAt
}
